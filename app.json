{
  "expo": {
    "name": "GRIDGO Supplier",
    "slug": "gridgo-supplier",
    "owner": "felyciaaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gridgosupplier",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gridgo.supplier"
    },
    "android": {
      "package": "ph.gridgo.supplier",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "GRIDGO uses the microphone only while you are on a call with the rider collecting a job. Calls are never recorded."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Regular.otf",
            "./assets/fonts/Satoshi-Medium.otf",
            "./assets/fonts/Satoshi-Bold.otf",
            "./assets/fonts/Satoshi-Black.otf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FFDE58",
          "sounds": ["./assets/audio/notification_alert.mp3"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GRIDGO uses the camera so you can attach proof photos of finished work to a job.",
          "photosPermission": "GRIDGO needs your photo library so you can attach proof photos of finished work to a job."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "GRIDGO uses the microphone only while you are on a call with the rider collecting a job. Calls are never recorded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
